{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dheerajjha/mcp-migrate/schemas/check-json.schema.json",
  "title": "mcp-migrate check --json output",
  "type": "object",
  "required": [
    "tool",
    "version",
    "spec",
    "path",
    "scannable",
    "languages",
    "grade",
    "score",
    "rule_filtered",
    "filters",
    "fail_on",
    "files_scanned",
    "counts",
    "findings",
    "suppressed",
    "unused_suppressions",
    "disabled_rules",
    "config_warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "const": "mcp-migrate"
    },
    "version": {
      "type": "string"
    },
    "spec": {
      "const": "2026-07-28"
    },
    "path": {
      "type": "string"
    },
    "scannable": {
      "type": "boolean"
    },
    "is_sdk": {
      "type": "boolean"
    },
    "sdk_reason": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "grade": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-F]$"
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "rule_filtered": {
      "type": "boolean",
      "description": "true when --rule restricted which rules ran. A grade computed from part of the rule set isn't a grade, so grade/score are null whenever this is true."
    },
    "filters": {
      "type": "object",
      "required": [
        "rule",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          }
        },
        "severity": {
          "type": "array",
          "items": {
            "enum": [
              "breaking",
              "deprecated",
              "advisory"
            ]
          }
        }
      }
    },
    "fail_on": {
      "enum": [
        "breaking",
        "deprecated",
        "advisory",
        "never"
      ],
      "description": "the --fail-on threshold used to compute the process exit code."
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "required": [
        "breaking",
        "deprecated",
        "advisory"
      ],
      "additionalProperties": false,
      "properties": {
        "breaking": {
          "type": "integer",
          "minimum": 0
        },
        "deprecated": {
          "type": "integer",
          "minimum": 0
        },
        "advisory": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "severity",
          "path",
          "line",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "breaking",
              "deprecated",
              "advisory"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "new": {
            "type": "boolean",
            "description": "present only when a baseline is active (top-level `baseline` key present). true if this finding did not match the baseline, i.e. it's what --fail-on evaluates; false if it matched and only still counts toward the grade."
          }
        }
      }
    },
    "suppressed": {
      "type": "array",
      "description": "findings silenced by an inline `mcp-migrate: ignore[R0NN]` comment. Not counted in `counts`, and not counted against the grade.",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "severity",
          "path",
          "line",
          "message",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "breaking",
              "deprecated",
              "advisory"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "the text after `--` in the ignore comment; empty if none was given"
          }
        }
      }
    },
    "unused_suppressions": {
      "type": "array",
      "description": "inline `mcp-migrate: ignore[R0NN]` directives that matched no finding. Either the finding was fixed or the code moved; both are worth knowing, because stale suppressions accumulate in CI and nothing else in the pipeline can see them. One entry per rule id: a directive naming several rules that matched nothing has every one of them stale.",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "path",
          "line",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "description": "the text after `--` in the ignore comment; empty if none was given"
          }
        }
      }
    },
    "disabled_rules": {
      "type": "array",
      "description": "rules switched off by project config (`[tool.mcp-migrate.rules]` in pyproject.toml, or a standalone .mcp-migrate.toml). These never run, so they contribute no findings and cost nothing against the grade.",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "reason": {
            "type": "string",
            "description": "the reason given in config, e.g. `R008 = \"off -- reason\"`; empty if none was given"
          }
        }
      }
    },
    "config_warnings": {
      "type": "array",
      "description": "problems found while reading project config -- malformed TOML, an unrecognised rule id, a value that isn't understood. Config that couldn't be read falls back to defaults rather than failing the run, so these are surfaced here instead.",
      "items": {
        "type": "string"
      }
    },
    "baseline": {
      "type": "object",
      "description": "present only when --baseline (or a `baseline` config key) was used. A baselined finding still counts toward `grade`/`score`/`counts` exactly as it always did -- this only says which findings are new since the baseline was recorded, which is what --fail-on evaluates when this is present.",
      "required": ["path", "new", "known", "stale"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "new": {
          "type": "integer",
          "minimum": 0,
          "description": "count of findings not matched by the baseline. --fail-on is evaluated against these, not against every finding, when a baseline is active."
        },
        "known": {
          "type": "integer",
          "minimum": 0,
          "description": "count of findings matched by the baseline. Still counted in `counts`/`grade`/`score` above -- a baseline never changes what those mean."
        },
        "stale": {
          "type": "array",
          "description": "baseline entries that matched nothing this run -- the underlying finding was fixed, or the code moved in a way the snippet key no longer recognises. Re-running --write-baseline drops these.",
          "items": {
            "type": "object",
            "required": ["rule", "path", "snippet"],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^R[0-9]{3}$"
              },
              "path": {
                "type": ["string", "null"]
              },
              "snippet": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "baseline_write": {
      "type": "object",
      "description": "present only when --write-baseline was used this run.",
      "required": ["path", "recorded", "new_since_last", "resolved", "prior_warning"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "recorded": {
          "type": "integer",
          "minimum": 0,
          "description": "every finding just written to `path`, replacing its previous contents entirely."
        },
        "new_since_last": {
          "type": ["integer", "null"],
          "description": "how many of `recorded` were not in the file's prior contents. null when the file did not exist before this run -- there is no prior version to diff against."
        },
        "resolved": {
          "type": ["integer", "null"],
          "description": "how many findings from the file's prior contents are absent from `recorded` -- fixed since the last write, and dropped by this one. null under the same condition as new_since_last."
        },
        "prior_warning": {
          "type": ["string", "null"],
          "description": "set if the file existed but could not be understood (malformed JSON, wrong shape) -- its prior contents were treated as empty rather than failing the run."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scannable": {
            "const": false
          }
        },
        "required": [
          "scannable"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "grade": {
            "const": null
          },
          "score": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_sdk": {
            "const": true
          }
        },
        "required": [
          "is_sdk"
        ]
      },
      "then": {
        "required": [
          "sdk_reason"
        ],
        "properties": {
          "grade": {
            "const": null
          },
          "score": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rule_filtered": {
            "const": true
          }
        },
        "required": [
          "rule_filtered"
        ]
      },
      "then": {
        "properties": {
          "grade": {
            "const": null
          },
          "score": {
            "const": null
          }
        }
      }
    }
  ]
}
